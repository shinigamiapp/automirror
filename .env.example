# ─── Local-only variables (kept outside Doppler) ─────────────────────────────

# Doppler service token — used by scraper-worker and db-sync containers
DOPPLER_TOKEN=dp.st.prd.xxxxxxxxxxxxxxxxxxxx
DOPPLER_PROJECT=automirror
DOPPLER_CONFIG=prd
LOG_LEVEL=debug

# Nginx Proxy
VIRTUAL_HOST=apollo.example.com
LETSENCRYPT_HOST=apollo.example.com

# MySQL (intentionally local — not in Doppler)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=automirror
MYSQL_USER=automirror
MYSQL_PASSWORD=

# ─── Doppler-managed secrets ─────────────────────────────────────────────────
# These are injected at runtime via `doppler run` — do NOT duplicate here.
#
# App config:
#   PORT, LOG_LEVEL, ABLY_API_KEY, ABLY_CHANNEL_PREFIX
#
# External services:
#   SCRAPER_BASE_URL, SCRAPER_HOSTS, SCRAPER_STRATEGY,
#   SCRAPER_HOST_TIMEOUT_MS, SCRAPER_HOST_MAX_FAILURES,
#   UPLOADER_BASE_URL, BACKEND_API_URL, CACHE_PURGE_URL,
#   API_URL, DASHBOARD_URL, DEFAULT_THUMBNAIL_URL
#
# API keys:
#   ADMIN_API_KEY, UPLOADER_API_KEY, BACKEND_API_KEY,
#   CACHE_PURGE_API_KEY, NOVU_API_KEY, NOVU_SUBSCRIBER_ID
#
# R2 / Backup:
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY,
#   BACKUP_R2_BUCKET_NAME, BACKUP_R2_PATH,
#   BACKUP_INTERVAL_SECONDS, BACKUP_RETENTION, SYNC_INTERVAL_SECONDS
